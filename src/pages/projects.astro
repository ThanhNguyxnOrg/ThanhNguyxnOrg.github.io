---
import Layout from '../layouts/Layout.astro';
import Explorer from '../sections/Explorer';
import CTA from '../sections/CTA';
import { loadSiteData } from '../lib/site-data';

const { projects } = await loadSiteData();
---

<Layout
  title="Projects — ThanhNguyxnOrg"
  description="Every ThanhNguyxnOrg repository in one searchable index."
  currentPath="/projects"
>
  <h1 class="sr-only">Projects — every ThanhNguyxnOrg repository in one searchable index</h1>
  <Explorer client:visible projects={projects} />
  <div id="support" class="scroll-mt-20 border-t border-border">
    <CTA client:visible />
  </div>
</Layout>
