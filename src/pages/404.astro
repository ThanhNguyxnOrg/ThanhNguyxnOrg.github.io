---
import Layout from '../layouts/Layout.astro';
import { Button } from '../components';
---

<Layout
  title="Not found — ThanhNguyxnOrg"
  description="This page does not exist. Back to verified ground."
  currentPath="/404"
>
  <div class="mx-auto w-full max-w-page px-5 py-20 md:px-8 md:py-28 lg:px-12">
    <p class="font-mono text-label uppercase text-primary-text">404</p>
    <h1 class="mt-4 font-display text-display-xl font-bold text-fg">Nothing here but honest void.</h1>
    <p class="mt-4 max-w-measure text-body-lg text-fg-muted">
      This URL never existed or moved without a trace. The index below is verified; start there.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/" size="lg">Back home</Button>
      <Button href="/projects" size="lg" variant="secondary">Browse projects</Button>
    </div>
  </div>
</Layout>

