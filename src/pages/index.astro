---
import Layout from '../layouts/Layout.astro';
import Hero from '../sections/Hero';
import Featured from '../sections/Featured';
import Philosophy from '../sections/Philosophy';
import Journey from '../sections/Journey';
import Explorer from '../sections/Explorer';
import Ecosystem from '../sections/Ecosystem';
import MetricsBand from '../sections/MetricsBand';
import TechMarquee from '../sections/TechMarquee';
import CTA from '../sections/CTA';
import { Container } from '../components';
import { loadSiteData } from '../lib/site-data';

const { baked, projects, stops, resources } = await loadSiteData();
---

<Layout
  title="ThanhNguyxnOrg: Build. Explore. Evolve."
  description="ThanhNguyxnOrg is an independent technology practice building developer tools, AI workflows, and open source utilities."
>
  <Hero client:load projects={projects} />
  <div class="border-b border-border">
    <Container className="py-10">
      <MetricsBand
        client:visible
        totals={{
          repos: baked.totals.repos,
          stars: baked.totals.stars,
          downloads30d: baked.totals.downloads30d,
          demos: baked.totals.demos,
        }}
        fetchedAt={baked.fetchedAt}
      />
    </Container>
  </div>
  <Featured client:visible projects={projects} />
  <TechMarquee />
  <Philosophy />
  <Journey client:visible stops={stops} repoCount={baked.totals.repos} foundedAt={baked.foundedAt ?? '2026-04-09'} projects={projects} />
  <Explorer client:visible projects={projects} limit={4} previewHref="/projects" />
  <Ecosystem client:visible resources={resources} fetchedAt={baked.fetchedAt} />
  <div id="support" class="scroll-mt-20 border-t border-border">
    <CTA client:visible />
  </div>
</Layout>
